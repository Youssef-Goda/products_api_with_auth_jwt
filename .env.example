PORT=5000

# Database
DATABASE_URL=your_database_url_here
SUPABASE_DATABASE_URL=your_supabase_database_url_here
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Secrets
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# External APIs & Services
IMGBB_API_KEY=your_imgbb_api_key_here
EMAIL_USER=your_email_user_here
EMAIL_PASS=your_email_pass_here

# Firebase (pass path or JSON string)
GOOGLE_APPLICATION_CREDENTIALS=google-credentials.json

# Security & CORS
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Paymob Payment Gateway (Egypt)
# Get these from: https://accept.paymob.com/portal2/en/settings
PAYMOB_API_KEY=your_paymob_api_key_here
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret_here
PAYMOB_CARD_INTEGRATION_ID=your_paymob_card_integration_id_here
PAYMOB_WALLET_INTEGRATION_ID=your_paymob_wallet_integration_id_here
PAYMOB_CASH_INTEGRATION_ID=your_paymob_cash_integration_id_here
PAYMOB_IFRAME_ID=your_paymob_iframe_id_here
# REQUIRED for wallet payments — get this from Paymob Dashboard → Payment Integrations → Iframes
# Create/find the Iframe linked to PAYMOB_WALLET_INTEGRATION_ID (5878638), NOT the card one.
# Without this, wallet payments fall back to PAYMOB_IFRAME_ID (the card iframe) and show card UI.
PAYMOB_WALLET_IFRAME_ID=your_paymob_wallet_iframe_id_here
# Paymob browser redirect URL (after card iframe payment completes).
PAYMOB_REDIRECT_URL=https://yourbackend.vercel.app/api/v1/payments/paymob/redirect
# Paymob server-to-server webhook notification URL (HMAC verified POST).
PAYMOB_NOTIFICATION_URL=https://yourbackend.vercel.app/api/v1/payments/paymob/webhook
# Frontend base URL for the callback redirect (Flutter web app).
FRONTEND_URL=https://yourfrontend.vercel.app/

PAYMOB_PUBLIC_KEY=your_paymob_public_key_here